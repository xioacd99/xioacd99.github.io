---
import View from '../../views/Article.astro';
import { getPosts, postSlug } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts('en')).map((post) => ({ params: { id: postSlug(post) }, props: { post } })); }
const { post } = Astro.props;
---
<View locale="en" post={post} />
