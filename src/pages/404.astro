---
import Layout from '../layouts/Layout.astro';
import { path } from '../lib/site';
---
<Layout title="Page not found" noindex><section class="container page-section not-found"><span class="eyebrow">404 / UNCHARTED TERRITORY</span><h1>No notes down this path.</h1><p>This page may have moved, or the link may be incorrect.</p><a class="button button-primary" href={path()}>Back to the notebook →</a></section></Layout>
