---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getPosts, postSlug } from '../lib/posts';
import { dateLabel } from '../lib/site';
import { localizedPath, ui, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const posts = await getPosts(locale);
const en = locale === 'en';
const t = ui[locale];
---
<Layout locale={locale} title={en ? 'Search' : '搜索'} noindex><section class="container page-section search-page"><div class="page-heading"><span class="eyebrow">FIND A THOUGHT</span><h1>{en ? 'What are you looking for?' : '你在寻找什么？'}<span>Search</span></h1><p>{en ? 'Search titles, summaries, topics, and article text. Everything stays in your browser.' : '搜索文章标题、摘要、主题与正文。所有搜索都在你的浏览器里完成。'}</p></div><form class="search-form" role="search"><label for="search-input" class="sr-only">{t.search}</label><Icon name="search" size={23}/><input id="search-input" name="q" type="search" placeholder={en ? 'Try AI, Markdown, or streaming…' : '试试 AI、Markdown 或 streaming…'} autocomplete="off" /><button class="button" type="submit">{en ? 'Search' : '搜索'}</button></form><p id="search-status" class="search-status" role="status" aria-live="polite">{en ? `All ${posts.length} articles` : `全部 ${posts.length} 篇文章`}</p><div id="search-results">{posts.map((post) => <article class="search-result" data-search={[post.data.title, post.data.description, ...post.data.tags, post.body].join(' ').toLowerCase()}><div class="eyebrow">{post.data.category}{post.data.demo && <span class="demo-badge">{t.demo}</span>}</div><h2><a href={localizedPath(`articles/${postSlug(post)}/`, locale)}>{post.data.title}</a></h2><p>{post.data.description}</p><span class="post-meta">{dateLabel(post.data.date, locale)} · {post.data.readingTime} {t.read}</span></article>)}</div><div id="empty-state" class="empty-state" hidden><span>↳</span><h2>{en ? 'No notes found just yet' : '暂时没有找到相关内容'}</h2><p>{en ? 'Try a different keyword, or explore the full archive.' : '换个关键词试试，或浏览全部文章。'}</p><a class="text-link" href={localizedPath('articles/', locale)}>{t.allArticles} →</a></div><noscript><p>{en ? 'Search needs JavaScript. You can still browse all articles below.' : '搜索需要 JavaScript。你也可以直接浏览下方全部文章。'}</p></noscript></section></Layout>
<script>
  const en = document.documentElement.lang === 'en';
  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const form = document.querySelector<HTMLFormElement>('.search-form')!;
  const results = [...document.querySelectorAll<HTMLElement>('.search-result')];
  const status = document.querySelector('#search-status')!;
  const empty = document.querySelector<HTMLElement>('#empty-state')!;
  function filter() {
    const query = input.value.trim().toLocaleLowerCase();
    const terms = query.split(/\s+/).filter(Boolean);
    let count = 0;
    results.forEach((result) => { const matches = terms.every((term) => result.dataset.search?.includes(term)); result.hidden = !matches; if (matches) count++; });
    status.textContent = query ? (en ? `${count} matching article${count === 1 ? '' : 's'}` : `找到 ${count} 篇相关文章`) : (en ? `All ${count} articles` : `全部 ${count} 篇文章`);
    empty.hidden = count > 0;
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }
  input.value = new URLSearchParams(location.search).get('q') || '';
  filter();
  input.addEventListener('input', filter);
  form.addEventListener('submit', (event) => { event.preventDefault(); filter(); });
</script>
