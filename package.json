{
  "name": "raymond-field-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1 --ignore-lock",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/generate-covers.mjs && node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1 --ignore-lock",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  }
}
