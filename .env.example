# GitHub user-site example. Set the origin separately for each deployment.
# For Sites use https://raymond-field-notes.feyslug64.chatgpt.site instead.
PUBLIC_SITE_URL=https://xioacd99.github.io
# User-site repositories (<owner>.github.io) and Sites both use /.
# Other GitHub project repositories use /<repository-name>.
PUBLIC_BASE_PATH=/
PUBLIC_REPOSITORY_URL=https://github.com/xioacd99/xioacd99.github.io
